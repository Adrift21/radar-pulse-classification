# ============================================
# Data and model files (IMPORTANT)
# ============================================
# Synthetic dataset (regenerable; too large for GitHub)
data_generation/synthetic_samples/*
!data_generation/synthetic_samples/.gitkeep


# Training outputs
experiments/checkpoints/*
!experiments/checkpoints/.gitkeep
experiments/results/*
!experiments/results/.gitkeep

# Model weights
*.pth
*.pt
*.ckpt
*.h5
*.hdf5
*.onnx
*.pb

# Large data formats
*.npy
*.npz
*.mat
*.tfrecord
*.parquet

# Exception: the frozen train/val/test split is small and must be versioned so that
# results are reproducible without regenerating it. See docs/dataset.md.
!configs/splits.npz

